<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 투명 배경 -->
    <solid android:color="#00000000" />

    <!-- 흰색 테두리 -->
    <stroke
        android:width="1dp"
        android:color="#FFFFFF" />

    <!-- 둥근 모서리 -->
    <corners android:radius="18dp" />

    <!-- 내부 여백 -->
    <padding
        android:left="10dp"
        android:top="5dp"
        android:right="10dp"
        android:bottom="5dp" />

</shape>